# Copy to .env and adjust as needed. All values are optional.

# SQLite database built by database/load_data.py (relative to the project root)
DB_PATH=database/urban_mobility.db

# API server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
CORS_ORIGIN=*

# A query running longer than this is aborted with HTTP 503 instead of hanging
QUERY_TIMEOUT_S=8
# Number of distinct query results kept in memory
CACHE_SIZE=512
