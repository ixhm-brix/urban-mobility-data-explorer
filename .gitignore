# --- data: too large for git; rebuild with the pipeline ---------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- database files ---------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.building
# dumps are generated by `python database/load_data.py --dump`, not stored
database/dump/*
!database/dump/.gitkeep

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
